{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "classrooms-route": {
        "ClusterId": "classroom-cluster",
        "Match": {
          "Path": "/api/classrooms/{**catch-all}"
        }
      },
      "subjects-route": {
        "ClusterId": "classroom-cluster",
        "Match": {
          "Path": "/api/subjects/{**catch-all}"
        }
      },
      "questions-route": {
        "ClusterId": "questionbank-cluster",
        "Match": {
          "Path": "/api/questions/{**catch-all}"
        }
      },
      "exams-route": {
        "ClusterId": "exam-cluster",
        "Match": {
          "Path": "/api/exams/{**catch-all}"
        }
      },
      "anticheat-route": {
        "ClusterId": "anticheat-cluster",
        "Match": {
          "Path": "/api/anticheat/{**catch-all}"
        }
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "classroom-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "questionbank-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "exam-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "anticheat-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
